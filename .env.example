# Copy to .env and fill in the values from the Firebase console
# (Project settings -> Your apps -> Web app). Never commit .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. "true" connects the app to the local Firebase emulators
# (Firestore 127.0.0.1:8080, Auth 127.0.0.1:9099). Only for the demo video
# recording (npm run demo:video); leave it unset for every real build.
VITE_USE_EMULATORS=
