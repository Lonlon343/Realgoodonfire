rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // A real account is any signed-in user that is not the anonymous session every
    // client receives on startup. Only real accounts may create content.
    function isRealAccount() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Products are keyed by their EAN/GTIN barcode.
    function isValidProductId(productId) {
      return productId is string && productId.matches('^[0-9]{8,14}$');
    }

    // Images may only point to OpenFoodFacts (https), or be empty.
    function isAllowedImage(value) {
      return value == ''
        || (
          value is string
          && value.size() <= 2048
          && value.matches('^https://[a-z0-9.-]+[.]openfoodfacts[.](org|net)/.*$')
        );
    }

    function isVoteChoice(value) {
      return value == 'up' || value == 'down';
    }

    function clampScore(score) {
      return score < 0 ? 0 : score > 100 ? 100 : score;
    }

    function expectedDupeMatchScore(priceSavingsPercentage, votes) {
      // Float division: with an int savings value, `/ 2` would truncate.
      return clampScore(50 + (priceSavingsPercentage / 2.0) + ((votes.up - votes.down) * 4));
    }

    function matchScoreIsValid(priceSavingsPercentage, votes, matchScore) {
      return matchScore is number
        && matchScore >= 0
        && matchScore <= 100
        && math.abs(matchScore - expectedDupeMatchScore(priceSavingsPercentage, votes)) <= 0.1;
    }

    function isValidOptionalPrice(value) {
      return value == null || (
        value is number
        && value > 0
        && value < 100
      );
    }

    function isNonEmptyString(value, maxSize) {
      return value is string && value.size() > 0 && value.size() <= maxSize;
    }

    function isBoundedString(value, maxSize) {
      return value is string && value.size() <= maxSize;
    }

    function isOptionalBoundedString(value, maxSize) {
      return value == null || isBoundedString(value, maxSize);
    }

    // The savings percentage must be derived from the two stored prices (client rounds
    // to one decimal), or be exactly 0 when a price comparison is not possible.
    function expectedSavingsPercentage(originalPrice, dupePrice) {
      // Float arithmetic: with int prices, `(a - b) / a` would truncate to an int.
      return ((originalPrice - dupePrice) * 100.0) / originalPrice;
    }

    function savingsPercentageIsValid(originalPrice, dupePrice, priceSavingsPercentage) {
      return priceSavingsPercentage is number && (
        (
          originalPrice is number
          && dupePrice is number
          && math.abs(priceSavingsPercentage - expectedSavingsPercentage(originalPrice, dupePrice)) <= 0.1
        ) || (
          (originalPrice == null || dupePrice == null)
          && priceSavingsPercentage == 0
        )
      );
    }

    function isValidDupeCreate(dupeDocId) {
      return isRealAccount()
        // Deterministic id: the same pair can only be created once.
        && dupeDocId == request.resource.data.originalId + '_' + request.resource.data.dupeId
        && request.resource.data.keys().hasOnly([
          'originalId',
          'originalName',
          'originalBrand',
          'originalCategory',
          'originalImage',
          'originalPrice',
          'dupeId',
          'dupeName',
          'dupeBrand',
          'dupeCategory',
          'dupeImage',
          'dupePrice',
          'createdBy',
          'matchScore',
          'priceSavingsPercentage',
          'votes',
          'userVotes',
          'createdAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && isNonEmptyString(request.resource.data.originalId, 64)
        && isNonEmptyString(request.resource.data.dupeId, 64)
        && request.resource.data.originalId != request.resource.data.dupeId
        && isBoundedString(request.resource.data.originalName, 200)
        && isBoundedString(request.resource.data.originalBrand, 120)
        && isBoundedString(request.resource.data.originalCategory, 60)
        && isAllowedImage(request.resource.data.originalImage)
        && isBoundedString(request.resource.data.dupeName, 200)
        && isBoundedString(request.resource.data.dupeBrand, 120)
        && isBoundedString(request.resource.data.dupeCategory, 60)
        && isAllowedImage(request.resource.data.dupeImage)
        && request.resource.data.createdAt == request.time
        && savingsPercentageIsValid(
          request.resource.data.originalPrice,
          request.resource.data.dupePrice,
          request.resource.data.priceSavingsPercentage
        )
        && request.resource.data.votes is map
        && request.resource.data.votes.keys().hasOnly(['up', 'down'])
        && request.resource.data.votes.up == 1
        && request.resource.data.votes.down == 0
        && request.resource.data.userVotes is map
        && request.resource.data.userVotes.keys().hasOnly([request.auth.uid])
        && request.resource.data.userVotes[request.auth.uid] == 'up'
        && isValidOptionalPrice(request.resource.data.originalPrice)
        && isValidOptionalPrice(request.resource.data.dupePrice)
        && matchScoreIsValid(
          request.resource.data.priceSavingsPercentage,
          request.resource.data.votes,
          request.resource.data.matchScore
        );
    }

    function hasOnlyVoteFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'userVotes', 'matchScore']);
    }

    // Legacy dupes may lack `userVotes`; a missing map key is read as null via
    // .get(), because indexing a missing key is an evaluation error in rules.
    function storedUserVotes() {
      return resource.data.get('userVotes', {});
    }

    function userVoteMapIsValid() {
      return storedUserVotes() is map
        && request.resource.data.userVotes is map
        && request.resource.data.userVotes.diff(storedUserVotes()).affectedKeys().hasOnly([request.auth.uid])
        && isVoteChoice(request.resource.data.userVotes.get(request.auth.uid, null));
    }

    function voteTransitionIsValid(previousVote, nextVote, oldVotes, newVotes) {
      return (
        previousVote == null
        && nextVote == 'up'
        && newVotes.up == oldVotes.up + 1
        && newVotes.down == oldVotes.down
      ) || (
        previousVote == null
        && nextVote == 'down'
        && newVotes.up == oldVotes.up
        && newVotes.down == oldVotes.down + 1
      ) || (
        previousVote == 'up'
        && nextVote == 'down'
        && newVotes.up == oldVotes.up - 1
        && newVotes.down == oldVotes.down + 1
      ) || (
        previousVote == 'down'
        && nextVote == 'up'
        && newVotes.up == oldVotes.up + 1
        && newVotes.down == oldVotes.down - 1
      );
    }

    function voteCountersAreValid() {
      return voteTransitionIsValid(
        storedUserVotes().get(request.auth.uid, null),
        request.resource.data.userVotes.get(request.auth.uid, null),
        resource.data.votes,
        request.resource.data.votes
      );
    }

    function isValidDupeVoteUpdate() {
      return isRealAccount()
        && resource.data.votes is map
        && request.resource.data.votes is map
        && request.resource.data.votes.keys().hasOnly(['up', 'down'])
        && hasOnlyVoteFieldsChanged()
        && userVoteMapIsValid()
        && voteCountersAreValid()
        && matchScoreIsValid(
          resource.data.priceSavingsPercentage,
          request.resource.data.votes,
          request.resource.data.matchScore
        );
    }

    function hasOnlyProductKeys() {
      return request.resource.data.keys().hasOnly([
        'name',
        'brand',
        'image',
        'nutriScore',
        'category',
        'price',
        'createdAt',
        'reviewCount',
        'averageRating',
        'nameLower',
        'brandLower',
        'lastReviewId'
      ]);
    }

    // Descriptive fields written by the barcode scanner (OpenFoodFacts import).
    function productDescriptiveFieldsAreValid(data) {
      return isNonEmptyString(data.name, 200)
        && isBoundedString(data.brand, 120)
        && isBoundedString(data.image, 2048)
        && (data.nutriScore == null || isBoundedString(data.nutriScore, 20))
        && isBoundedString(data.category, 40)
        && isBoundedString(data.nameLower, 200)
        && isBoundedString(data.brandLower, 120);
    }

    function productAffectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Descriptive refresh (real accounts only): descriptive fields only, never
    // counters or price. The image is validated only when it changes, so legacy
    // products with other image values stay editable.
    function isProductScanUpdate() {
      return productAffectedKeys().hasOnly([
        'name', 'brand', 'image', 'nutriScore', 'category', 'nameLower', 'brandLower'
      ])
      && productDescriptiveFieldsAreValid(request.resource.data)
      && (!productAffectedKeys().hasAny(['image']) || isAllowedImage(request.resource.data.image));
    }

    function reviewPath(reviewId) {
      return /databases/$(database)/documents/reviews/$(reviewId);
    }

    // The stats write must name a review that is created in the same
    // transaction/batch, by the same user, for this product.
    function isNewOwnReviewOfProduct(reviewId, productId) {
      return reviewId is string
        && reviewId.size() > 0
        && reviewId.size() <= 64
        && !exists(reviewPath(reviewId))
        && existsAfter(reviewPath(reviewId))
        && getAfter(reviewPath(reviewId)).data.productId == productId
        && getAfter(reviewPath(reviewId)).data.userId == request.auth.uid;
    }

    // Float-safe running average; the client rounds to one decimal (max 0.05).
    function averageIsValid(oldAverage, oldCount, rating, newAverage) {
      return newAverage is number
        && newAverage >= 0
        && newAverage <= 5
        && math.abs(newAverage - (((oldAverage * oldCount) + rating) / (oldCount + 1.0))) <= 0.06;
    }

    // addReview transaction on an existing product: exactly one more review,
    // tied to the review created in the same transaction.
    function isProductReviewStatsUpdate(productId) {
      return productAffectedKeys().hasOnly(['reviewCount', 'averageRating', 'price', 'lastReviewId'])
        && isNewOwnReviewOfProduct(request.resource.data.get('lastReviewId', null), productId)
        && request.resource.data.reviewCount is int
        && request.resource.data.reviewCount == resource.data.get('reviewCount', 0) + 1
        && averageIsValid(
          resource.data.get('averageRating', 0),
          resource.data.get('reviewCount', 0),
          getAfter(reviewPath(request.resource.data.lastReviewId)).data.rating,
          request.resource.data.averageRating
        )
        && isValidOptionalPrice(request.resource.data.get('price', null));
    }

    // Shared checks of both product create paths.
    function isValidProductCreateBase(productId) {
      return isValidProductId(productId)
        && hasOnlyProductKeys()
        && productDescriptiveFieldsAreValid(request.resource.data)
        && isAllowedImage(request.resource.data.image)
        && request.resource.data.createdAt == request.time
        && isValidOptionalPrice(request.resource.data.get('price', null));
    }

    // Scanner import (anonymous sessions allowed): empty counters.
    function isProductScanCreate() {
      return request.resource.data.reviewCount == 0
        && request.resource.data.averageRating == 0
        && !('lastReviewId' in request.resource.data);
    }

    // addReview transaction when the product document is missing: the product is
    // created together with its first review.
    function isProductCreateWithFirstReview(productId) {
      return isRealAccount()
        && request.resource.data.reviewCount == 1
        && isNewOwnReviewOfProduct(request.resource.data.get('lastReviewId', null), productId)
        && averageIsValid(
          0,
          0,
          getAfter(reviewPath(request.resource.data.lastReviewId)).data.rating,
          request.resource.data.averageRating
        );
    }

    // createDupeLink: stores a price learned from the dupe form.
    function isProductPriceUpdate() {
      return productAffectedKeys().hasOnly(['price'])
        && isValidOptionalPrice(request.resource.data.get('price', null));
    }

    match /products/{productId} {
      allow read: if true;
      // First import of a product (scanner: anonymous session allowed), or the
      // product created together with its first review (real accounts).
      allow create: if isSignedIn()
        && isValidProductCreateBase(productId)
        && (isProductScanCreate() || isProductCreateWithFirstReview(productId));
      // Updates are reserved for real accounts; anonymous sessions only create.
      allow update: if isRealAccount()
        && hasOnlyProductKeys()
        && (
          isProductScanUpdate()
          || isProductReviewStatsUpdate(productId)
          || isProductPriceUpdate()
        );
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isRealAccount()
        && request.resource.data.userId == request.auth.uid
        // Display identity must match the signed-in user's ID token, so a review can
        // never be posted under another user's name or avatar.
        && request.resource.data.userName == request.auth.token.get('name', 'Foodie')
        && isNonEmptyString(request.resource.data.userName, 80)
        && (
          request.resource.data.userAvatar == null
          || request.resource.data.userAvatar == request.auth.token.get('picture', null)
        )
        && isNonEmptyString(request.resource.data.productId, 64)
        && isBoundedString(request.resource.data.productName, 200)
        && isBoundedString(request.resource.data.brand, 120)
        && isAllowedImage(request.resource.data.image)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && isBoundedString(request.resource.data.comment, 500)
        && isOptionalBoundedString(request.resource.data.store, 40)
        && request.resource.data.isDupe is bool
        && isOptionalBoundedString(request.resource.data.dupeTarget, 200)
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'productId',
          'productName',
          'brand',
          'image',
          'rating',
          'comment',
          'price',
          'store',
          'isDupe',
          'dupeTarget',
          'createdAt',
          'userId',
          'userName',
          'userAvatar'
        ])
        && isValidOptionalPrice(request.resource.data.price);
      // Account deletion: a real account may delete its own reviews.
      allow delete: if isRealAccount() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /dupes/{dupeDocId} {
      allow read: if true;
      allow create: if isValidDupeCreate(dupeDocId);
      allow update: if isValidDupeVoteUpdate();
      allow delete: if false;
    }

    function isValidReportReason(value) {
      return value == 'spam'
        || value == 'harassment'
        || value == 'inappropriate'
        || value == 'other';
    }

    function isValidReportDetails(value) {
      return value == null || (value is string && value.size() <= 500);
    }

    match /reports/{reportId} {
      // Reports are only readable/writable from the backend (Admin SDK).
      // Clients may create a report for themselves but never read or modify them.
      allow read, update, delete: if false;
      allow create: if isRealAccount()
        && request.resource.data.reporterUserId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'reviewId',
          'reporterUserId',
          'reason',
          'details',
          'status',
          'createdAt'
        ])
        && isNonEmptyString(request.resource.data.reviewId, 64)
        && isValidReportReason(request.resource.data.reason)
        && isValidReportDetails(request.resource.data.details)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }
  }
}